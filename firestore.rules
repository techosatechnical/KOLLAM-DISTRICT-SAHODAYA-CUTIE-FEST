rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to verify if the authenticated user is an authorized administrator
    function isAdmin() {
      return request.auth != null && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        request.auth.token.admin == true
      );
    }

    // Schools collection: Public read access, Admin-only write access (no permanent delete if results exist)
    match /schools/{schoolId} {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 3
        && request.resource.data.category1Participation is bool
        && request.resource.data.category2Participation is bool
        && request.resource.data.isActive is bool;
      allow delete: if isAdmin();
    }

    // Events collection: Public read access, Admin-only write access
    match /events/{eventId} {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.data.name is string
        && request.resource.data.category in ['CATEGORY_I', 'CATEGORY_II']
        && request.resource.data.eventType in ['OFF_STAGE', 'ON_STAGE', 'GROUP_ITEM']
        && request.resource.data.scoringType in ['INDIVIDUAL', 'GROUP']
        && request.resource.data.status in ['PENDING', 'COMPLETED', 'PUBLISHED'];
      allow delete: if isAdmin();
    }

    // Results collection:
    // Public visitors have read-only access to PUBLISHED results.
    // Authorized admins can read all results and create, update, publish, or delete results with server-side validation.
    match /results/{resultId} {
      allow read: if resource.data.publicationStatus == 'PUBLISHED' || isAdmin();
      allow create, update: if isAdmin()
        && request.resource.data.percentage is number
        && request.resource.data.percentage >= 0
        && request.resource.data.percentage <= 100
        && request.resource.data.grade in ['A', 'B', 'C', 'No Grade']
        && request.resource.data.category in ['CATEGORY_I', 'CATEGORY_II']
        && request.resource.data.publicationStatus in ['DRAFT', 'PUBLISHED', 'UNAWARDED_PENDING']
        && request.resource.data.totalPoints == request.resource.data.gradePoints + request.resource.data.placePoints;
      allow delete: if isAdmin();
    }

    // Admins collection: Only authenticated admins can read their own profile
    match /admins/{adminId} {
      allow read: if request.auth != null && (request.auth.uid == adminId || isAdmin());
      allow write: if isAdmin();
    }
  }
}

